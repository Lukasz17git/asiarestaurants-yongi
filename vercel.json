{
  "framework": "create-react-app",
  "installCommand": "npm install",
  "buildCommand": "printf '{\"sha\":\"%s\",\"ref\":\"%s\"}' \"$VERCEL_GIT_COMMIT_SHA\" \"$VERCEL_GIT_COMMIT_REF\" > public/version.json && CI=false npm run build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
